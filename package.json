{
  "name": "pacman",
  "version": "0.7.7",
  "description": "Pac-Man Node.js game with pluggable database backends (memory / MongoDB / PostgreSQL)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test --test-reporter=spec 'test/**/*.test.js'",
    "test:adapters": "RUN_ADAPTER_TESTS=1 node --test --test-reporter=spec 'test/adapters/*.test.js'",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:migrate": "node src/db/migrate.js",
    "simulate:users": "node tools/simulate-users.js"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "dotenv": "^16.4.5",
    "express": "^5.0.1",
    "mongodb": "^6.10.0",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "pug": "^3.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testcontainers/mongodb": "^12.0.0",
    "@testcontainers/postgresql": "^12.0.0",
    "eslint": "^9.14.0",
    "globals": "^15.12.0",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0",
    "testcontainers": "^12.0.0"
  },
  "license": "GPL-3.0-or-later"
}
