# Server
PORT=8080
GRPC_PORT=9090
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=development

# Database selection: memory | mongo | postgres
DB_TYPE=memory

# --- Cilium demo/runtime metadata -----------------------------------------
# One image can run multiple Kubernetes roles for east-west traffic demos.
APP_ROLE=web
APP_VERSION=dev
APP_VARIANT=stable
APP_COLOR=#ffcc00
COMMIT_SHA=unknown
BUILD_DATE=unknown

# Optional internal service URLs used by the web role. Leave blank for local
# in-process behavior.
SCORE_SERVICE_URL=
USER_SERVICE_URL=
CONFIG_SERVICE_URL=
TOPOLOGY_SERVICE_URL=

# Lab-only fault injection and runtime incident probes. Demo actions require
# both DEMO_SECURITY_MODE=true and the configured token header.
DEMO_SECURITY_MODE=false
DEMO_TOKEN_HEADER=x-demo-token
DEMO_TOKEN=pacman-demo

# --- MongoDB (DB_TYPE=mongo) ----------------------------------------------
# Comma-separated host list is supported (joined with the same port).
MONGO_SERVICE_HOST=localhost
MY_MONGO_PORT=27017
MONGO_DATABASE=pacman
MONGO_AUTH_USER=
MONGO_AUTH_PWD=
MONGO_REPLICA_SET=
MONGO_USE_SSL=false
MONGO_VALIDATE_SSL=true

# --- PostgreSQL (DB_TYPE=postgres) ----------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pacman
POSTGRES_USER=pacman
POSTGRES_PASSWORD=pacman
POSTGRES_SSL=false

# --- Gameplay -------------------------------------------------------------
# MAX_LEVEL accepts a positive integer or unlimited.
MAX_LEVEL=10
ALLOW_CLIENT_CONFIG_OVERRIDE=true

# eBee mode swaps Pac-Man/ghost/pill/life visuals while keeping game rules.
# Set ALLOW_CLIENT_EBEE_MODE_OVERRIDE=false to make EBEE_MODE server-authoritative.
EBEE_MODE=false
ALLOW_CLIENT_EBEE_MODE_OVERRIDE=true
